node_modules/
dist/
coverage/

# Tauri desktop shell: Rust build output is ~1.2GB and regenerates from source.
src-tauri/target/
src-tauri/gen/schemas/

# Packaged binaries are published as GitHub Release assets, not committed.
# An unsigned .exe in git history is ~11MB that can never be taken out of a
# clone, and a lean source tree reads better than an unknown executable.
releases/

# Local calibration probes and match reports. Stockfish is downloaded only for
# headless strength checks; neither its binary nor machine-specific results
# belong in the source repository.
.calibration/
